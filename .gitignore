# Dependencies
node_modules/

# Build output
dist/
build/

# Environment and secrets. Runtime configuration is supplied by the
# CloudFormation stack via /etc/ai-chat.env on the instance; nothing secret
# belongs in this repository.
.env
.env.*
*.pem
*.key

# Local operator notes holding real account identifiers, deliberately kept out of
# the public repository. See DEPLOYMENT.local.md.
*.local.md
*.local.json
*.local.yaml

# Logs
*.log
npm-debug.log*

# OS and editor cruft
.DS_Store
.idea/
.vscode/
*.swp
